{
  "name": "shamela-mcp",
  "version": "2.3.0",
  "private": true,
  "description": "MCP server exposing shamela.ws (Islamic digital library) as a set of tools: browse categories/authors, read book pages, and run full-text search.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.mjs",
    "resolve:canonical": "node scripts/resolve-canonical-editions.mjs",
    "build:index": "node scripts/build-hadith-index.mjs",
    "build:tafsir": "node scripts/build-tafsir-index.mjs",
    "check:coverage": "node scripts/check-coverage.mjs",
    "verify": "npm test && wrangler deploy --dry-run --outdir /tmp/wrangler-dry-run"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=22"
  }
}
