{
  "name": "shamela-mcp",
  "version": "2.5.0",
  "private": true,
  "description": "MCP server exposing shamela.ws (Islamic digital library) as a set of tools: browse categories/authors, read book pages, and run full-text search.",
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "node --check server.mjs src/index.mjs",
    "lint": "node --check server.mjs src/index.mjs src/tools.mjs",
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:live": "SHAMELA_LIVE_TESTS=1 node --test test/live.test.mjs",
    "resolve:canonical": "node scripts/resolve-canonical-editions.mjs",
    "build:index": "node scripts/build-hadith-index.mjs",
    "build:tafsir": "node scripts/build-tafsir-index.mjs",
    "validate:index": "node scripts/validate-index.mjs",
    "refresh:orchestrate": "node scripts/orchestrate-refresh.mjs",
    "verify": "npm test"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=22"
  }
}
